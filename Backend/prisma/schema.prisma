// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────

enum TripStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum SectionType {
  TRAVEL
  HOTEL
  ACTIVITY
  SIGHTSEEING
  FOOD
  TRANSPORT
  OTHER
}

// ─── Models ──────────────────────────────────

model User {
  id                    Int      @id @default(autoincrement())
  firstName             String
  lastName              String
  email                 String   @unique
  password              String
  phoneNumber           String
  city                  String
  country               String
  additionalInformation String?
  photo                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  trips                 Trip[]
}

model Region {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String?
  image        String?
  countryCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  destinations Destination[]
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  city        String
  description String?
  image       String?
  regionId    Int
  latitude    Float?
  longitude   Float?
  popularity  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  region           Region            @relation(fields: [regionId], references: [id])
  tripDestinations TripDestination[]
  tripSections     TripSection[]
  activities       Activity[]
}

model Trip {
  id          Int        @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      TripStatus @default(PLANNED)
  budget      Float?
  currency    String     @default("INR")
  coverImage  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  tripDestinations TripDestination[]
  tripActivities   TripActivity[]
  sections         TripSection[]

  @@index([userId, startDate, endDate])
  @@index([userId, status])
}

model TripDestination {
  id            Int       @id @default(autoincrement())
  tripId        Int
  destinationId Int
  visitDate     DateTime?
  order         Int       @default(0)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])
}

model Activity {
  id                Int            @id @default(autoincrement())
  name              String
  description       String?
  category          String
  image             String?
  city              String
  country           String
  destinationId     Int?
  latitude          Float?
  longitude         Float?
  estimatedDuration Float?
  estimatedCost     Float?
  currency          String         @default("INR")
  popularity        Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  destination    Destination?   @relation(fields: [destinationId], references: [id])
  tripActivities TripActivity[]
  tripSections   TripSection[]

  @@index([name])
  @@index([category])
  @@index([city])
  @@index([country])
  @@index([popularity])
  @@index([estimatedCost])
  @@index([destinationId])
}

model TripActivity {
  id          Int       @id @default(autoincrement())
  tripId      Int
  activityId  Int
  plannedDate DateTime?
  startTime   String?
  endTime     String?
  order       Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id])
}

model TripSection {
  id            Int         @id @default(autoincrement())
  tripId        Int
  title         String
  description   String?
  type          SectionType
  startDate     DateTime
  endDate       DateTime
  budget        Float?
  currency      String      @default("INR")
  location      String?
  notes         String?
  order         Int         @default(0)
  destinationId Int?
  activityId    Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id])
  activity    Activity?    @relation(fields: [activityId], references: [id])
}

model Banner {
  id         Int      @id @default(autoincrement())
  title      String
  subtitle   String?
  image      String?
  badge      String?
  buttonText String?
  buttonLink String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────

enum TripStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

// ─── Models ──────────────────────────────────

model User {
  id                    Int      @id @default(autoincrement())
  firstName             String
  lastName              String
  email                 String   @unique
  password              String
  phoneNumber           String
  city                  String
  country               String
  additionalInformation String?
  photo                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  trips                 Trip[]
}

model Region {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String?
  image        String?
  countryCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  destinations Destination[]
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  city        String
  description String?
  image       String?
  regionId    Int
  latitude    Float?
  longitude   Float?
  popularity  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  region           Region            @relation(fields: [regionId], references: [id])
  tripDestinations TripDestination[]
}

model Trip {
  id          Int        @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      TripStatus @default(PLANNED)
  budget      Float?
  currency    String     @default("INR")
  coverImage  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  tripDestinations TripDestination[]
}

model TripDestination {
  id            Int       @id @default(autoincrement())
  tripId        Int
  destinationId Int
  visitDate     DateTime?
  order         Int       @default(0)
  notes         String?
  createdAt     DateTime  @default(now())

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])
}

model Banner {
  id         Int      @id @default(autoincrement())
  title      String
  subtitle   String?
  image      String?
  badge      String?
  buttonText String?
  buttonLink String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

### ====================================================================
### GlobeTrotter Backend API Test Suite (Screens 1 to 5)
### Format: VS Code / Antigravity REST Client (.http)
### ====================================================================

### Global Variables
@baseUrl = http://localhost:5000
@contentType = application/json

### --------------------------------------------------------------------
### VARIABLES TO REPLACE AS YOU TEST:
### 1. After Step 1 (Login), paste the returned JWT token below into @authToken:
@authToken = YOUR_ACCESS_TOKEN

### 2. IDs you will copy from API responses:
@destinationId = 1
@activityId = 4
@tripId = 1
@tripActivityId = 1
@tripDestinationId = 1
@sectionId1 = 1
@sectionId2 = 2
@sectionId3 = 3


### ====================================================================
### 0. HEALTH CHECK
### ====================================================================

# @name healthCheck
GET {{baseUrl}}/
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 1: AUTHENTICATION (Register & Login)
### ====================================================================

### 1a. Register New User (Optional)
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "firstName": "Rudra",
  "lastName": "Patel",
  "email": "rudra@example.com",
  "password": "Password@123",
  "phoneNumber": "9876543210",
  "city": "Ahmedabad",
  "country": "India",
  "additionalInformation": "Traveler & Explorer",
  "photo": "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=400"
}

### 1b. Login (COPY THE TOKEN FROM THIS RESPONSE TO @authToken ABOVE)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "rudra@example.com",
  "password": "Password@123"
}

### 1c. Get Logged-in User Profile
# @name getProfile
GET {{baseUrl}}/api/auth/profile
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 2: GET AN EXISTING TRIP
### ====================================================================

### 2a. Get All My Active / Planned Trips
### -> COPY AN EXISTING "id" INTO @tripId AT THE TOP!
# @name getMyTrips
GET {{baseUrl}}/api/trips/my
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### 2b. Plan a New Trip (If you need a fresh trip: Oct 10 to Oct 20)
# @name planNewTrip
POST {{baseUrl}}/api/trips/plan
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Japan Vacation 2026",
  "description": "10-day trip covering Tokyo and Kyoto",
  "destinationId": 1,
  "destinationIds": [2],
  "activityIds": [1, 2, 3],
  "startDate": "2026-10-10",
  "endDate": "2026-10-20",
  "budget": 180000,
  "currency": "INR",
  "coverImage": "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=800"
}

###


### ====================================================================
### STEP 3: GET SECTIONS (SCREEN 5)
### ====================================================================

### 3. Get All Sections of Trip
# @name getSections
GET {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 4: CREATE SECTION 1 (Hotel)
### ====================================================================

### 4. Create Section 1: Tokyo Hotel
### -> COPY THE "id" FROM THIS RESPONSE INTO @sectionId1 AT THE TOP!
# @name createSection1
POST {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Tokyo Hotel",
  "description": "Hotel stay in Shibuya near major transit hubs",
  "type": "HOTEL",
  "startDate": "2026-10-10",
  "endDate": "2026-10-12",
  "budget": 30000,
  "currency": "INR",
  "location": "Shibuya, Tokyo",
  "notes": "Near metro station, breakfast included",
  "order": 1
}

###


### ====================================================================
### STEP 5: CREATE SECTION 2 (Sightseeing)
### ====================================================================

### 5. Create Section 2: Tokyo Sightseeing
### -> COPY THE "id" FROM THIS RESPONSE INTO @sectionId2 AT THE TOP!
# @name createSection2
POST {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Tokyo Sightseeing",
  "description": "Visit major Tokyo attractions including Tokyo Tower and Shibuya",
  "type": "SIGHTSEEING",
  "startDate": "2026-10-12",
  "endDate": "2026-10-14",
  "budget": 15000,
  "currency": "INR",
  "location": "Tokyo",
  "notes": "Tokyo Tower and Shibuya Crossing",
  "order": 2
}

###


### ====================================================================
### STEP 6: CREATE SECTION 3 (Travel)
### ====================================================================

### 6. Create Section 3: Kyoto Travel
### -> COPY THE "id" FROM THIS RESPONSE INTO @sectionId3 AT THE TOP!
# @name createSection3
POST {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Kyoto Travel",
  "description": "Travel from Tokyo to Kyoto via Shinkansen Bullet Train",
  "type": "TRAVEL",
  "startDate": "2026-10-15",
  "endDate": "2026-10-16",
  "budget": 20000,
  "currency": "INR",
  "location": "Tokyo to Kyoto",
  "notes": "Book Shinkansen window seats",
  "order": 3
}

###


### ====================================================================
### STEP 7: VERIFY ALL SECTIONS
### ====================================================================

### 7. List Sections - Verify Section 1, 2, 3 in Order
# @name verifyAllSections
GET {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 8: GET SINGLE SECTION
### ====================================================================

### 8. Get Section 1 Details
# @name getSingleSection
GET {{baseUrl}}/api/trips/{{tripId}}/sections/{{sectionId1}}
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 9: UPDATE SECTION
### ====================================================================

### 9. Update Section 1
# @name updateSection
PUT {{baseUrl}}/api/trips/{{tripId}}/sections/{{sectionId1}}
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Updated Tokyo Hotel",
  "budget": 35000,
  "notes": "Updated hotel preference: High floor room"
}

###


### ====================================================================
### STEP 10: REORDER SECTIONS
### ====================================================================

### 10a. Reorder Sections (Set Section 3 -> Order 1, Section 1 -> Order 2, Section 2 -> Order 3)
# @name reorderSections
PUT {{baseUrl}}/api/trips/{{tripId}}/sections/reorder
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "sectionIds": [
    {{sectionId3}},
    {{sectionId1}},
    {{sectionId2}}
  ]
}

### 10b. Verify Reordered Sections
# @name verifyReorderedSections
GET {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 11: GET COMPLETE ITINERARY (EXTENDED FOR SCREEN 5)
### ====================================================================

### 11. Complete Itinerary (Returns Trip + Sections + Destinations + Activities + Days)
# @name getCompleteItinerary
GET {{baseUrl}}/api/trips/{{tripId}}/itinerary
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 12: GET TRIP BUDGET SUMMARY (SCREEN 5)
### ====================================================================

### 12. Trip Budget Breakdown (Trip Budget, Section Total, Remaining Budget)
# @name getTripBudget
GET {{baseUrl}}/api/trips/{{tripId}}/budget
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 13: LINK / UNLINK DESTINATION & ACTIVITY TO SECTION
### ====================================================================

### 13a. Link Destination to Section 2
# @name linkSectionDestination
POST {{baseUrl}}/api/trips/{{tripId}}/sections/{{sectionId2}}/destination
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "destinationId": 1
}

### 13b. Link Activity to Section 2
# @name linkSectionActivity
POST {{baseUrl}}/api/trips/{{tripId}}/sections/{{sectionId2}}/activity
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "activityId": 1
}

### 13c. Unlink Destination from Section 2
# @name unlinkSectionDestination
DELETE {{baseUrl}}/api/trips/{{tripId}}/sections/{{sectionId2}}/destination
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### 13d. Unlink Activity from Section 2
# @name unlinkSectionActivity
DELETE {{baseUrl}}/api/trips/{{tripId}}/sections/{{sectionId2}}/activity
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 14: DELETE SECTION
### ====================================================================

### 14a. Delete Section 2 (Auto-normalizes remaining orders)
# @name deleteSection
DELETE {{baseUrl}}/api/trips/{{tripId}}/sections/{{sectionId2}}
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### 14b. Verify Normalized Remaining Sections
# @name verifyAfterDelete
GET {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### STEP 15: VALIDATION & ERROR CHECKS
### ====================================================================

### 15a. Invalid Date Order (endDate before startDate) -> Expects 400 Bad Request
# @name testInvalidDateOrder
POST {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Invalid Section Date Order",
  "type": "HOTEL",
  "startDate": "2026-10-20",
  "endDate": "2026-10-10",
  "budget": 10000,
  "currency": "INR"
}

### 15b. Outside Parent Trip Dates -> Expects 400 Bad Request
# @name testOutsideTripDates
POST {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Invalid Section Outside Dates",
  "type": "HOTEL",
  "startDate": "2026-10-25",
  "endDate": "2026-10-27",
  "budget": 10000,
  "currency": "INR"
}

### 15c. Negative Budget -> Expects 400 Bad Request
# @name testNegativeBudget
POST {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Invalid Negative Budget",
  "type": "HOTEL",
  "startDate": "2026-10-10",
  "endDate": "2026-10-12",
  "budget": -5000,
  "currency": "INR"
}

### 15d. Invalid Section Type -> Expects 400 Bad Request
# @name testInvalidSectionType
POST {{baseUrl}}/api/trips/{{tripId}}/sections
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Invalid Section Type Test",
  "type": "INVALID_TYPE",
  "startDate": "2026-10-10",
  "endDate": "2026-10-12",
  "budget": 10000,
  "currency": "INR"
}

###


### ====================================================================
### SCREEN 6: USER TRIP LISTING (ALL SCENARIOS)
### ====================================================================

### STEP 1: Main User Trip Listing (Default: Grouped by Ongoing / Upcoming / Completed + Counts)
# @name getUserTripsMain
GET {{baseUrl}}/api/trips
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 2: Dedicated Ongoing Trips Endpoint
# @name getOngoingTrips
GET {{baseUrl}}/api/trips/ongoing
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 3: Dedicated Upcoming Trips Endpoint
# @name getUpcomingTrips
GET {{baseUrl}}/api/trips/upcoming
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 4: Dedicated Completed Trips Endpoint
# @name getCompletedTrips
GET {{baseUrl}}/api/trips/completed
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 5: Search Trips by keyword (Title, Description, Destination, City, Country)
# @name searchTrips
GET {{baseUrl}}/api/trips?search=tokyo
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 6: Filter Trips by Status (ongoing | upcoming | completed | cancelled)
# @name filterTripsStatus
GET {{baseUrl}}/api/trips?status=upcoming
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 7a: Sort Trips by Nearest Start Date
# @name sortTripsDateAsc
GET {{baseUrl}}/api/trips?sort=start_date_asc
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 7b: Sort Trips by Highest Budget
# @name sortTripsBudgetDesc
GET {{baseUrl}}/api/trips?sort=budget_desc
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 8: Group Trips by Destination
# @name groupTripsByDestination
GET {{baseUrl}}/api/trips?groupBy=destination
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 9: Paginated Trips Listing (Page 1, Limit 2)
# @name paginateTrips
GET {{baseUrl}}/api/trips?page=1&limit=2
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 10: Filter Trips by Budget Range (50,000 to 250,000)
# @name filterTripsBudgetRange
GET {{baseUrl}}/api/trips?minBudget=50000&maxBudget=250000
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 11: Combined Query (Search + Filter + Sort + Pagination)
# @name combinedTripsQuery
GET {{baseUrl}}/api/trips?search=japan&status=upcoming&sort=start_date_asc&page=1&limit=10
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 12: Single Trip Details by ID
# @name getSingleTripDetails
GET {{baseUrl}}/api/trips/{{tripId}}
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### SCREEN 6 VALIDATION & ERROR CHECKS
### ====================================================================

### 13a. Invalid Status -> Expects 400 Bad Request
# @name testInvalidStatus
GET {{baseUrl}}/api/trips?status=invalid_status
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### 13b. Invalid Sort -> Expects 400 Bad Request
# @name testInvalidSort
GET {{baseUrl}}/api/trips?sort=invalid_sort
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### 13c. Invalid Page (< 1) -> Expects 400 Bad Request
# @name testInvalidPage
GET {{baseUrl}}/api/trips?page=-1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### 13d. Invalid Limit (> 50) -> Expects 400 Bad Request
# @name testInvalidLimit
GET {{baseUrl}}/api/trips?limit=99999
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### 13e. Invalid Budget Range (maxBudget < minBudget) -> Expects 400 Bad Request
# @name testInvalidBudgetRange
GET {{baseUrl}}/api/trips?minBudget=100000&maxBudget=50000
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### 13f. Invalid Date Range (endDate < startDate) -> Expects 400 Bad Request
# @name testInvalidTripDateFilter
GET {{baseUrl}}/api/trips?startDate=2026-12-31&endDate=2026-01-01
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### SCREEN 7: USER PROFILE & DASHBOARD (ALL SCENARIOS)
### ====================================================================

### STEP 1: Get Current Logged-in User Profile
# @name getMyProfile
GET {{baseUrl}}/api/auth/profile
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 2: Update Profile (Full Update via PUT)
# @name updateMyProfile
PUT {{baseUrl}}/api/auth/profile
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "firstName": "Rudra Updated",
  "lastName": "Patel",
  "phoneNumber": "9876543210",
  "city": "Ahmedabad",
  "country": "India",
  "additionalInformation": "Passionate backpacker, solo traveler, and travel blogger.",
  "photo": "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=400"
}

### STEP 3: Partial Profile Update via PATCH
# @name patchMyProfile
PATCH {{baseUrl}}/api/auth/profile
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "city": "Gandhinagar"
}

### STEP 4: Get Profile Dashboard (User Details + Preplanned + Previous + Counts)
# @name getProfileDashboard
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 5: Get Preplanned / Upcoming Trips
# @name getPreplannedTrips
GET {{baseUrl}}/api/users/me/trips/preplanned
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 6: Get Previous / Completed Trips
# @name getPreviousTrips
GET {{baseUrl}}/api/users/me/trips/previous
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 7: Get Trip Summary Counts
# @name getTripSummaryCounts
GET {{baseUrl}}/api/users/me/trips/summary
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 8: View Trip Details from Profile Card (Using real trip ID)
# @name viewTripFromProfile
GET {{baseUrl}}/api/trips/{{tripId}}
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

###


### ====================================================================
### SCREEN 7 VALIDATION & ERROR CHECKS
### ====================================================================

### 9a. Invalid Profile Update: Empty First Name -> Expects 400 Bad Request
# @name testEmptyFirstName
PUT {{baseUrl}}/api/auth/profile
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "firstName": "",
  "lastName": "Patel"
}

### 9b. Invalid Profile Update: Short Phone Number -> Expects 400 Bad Request
# @name testInvalidPhone
PUT {{baseUrl}}/api/auth/profile
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "phoneNumber": "123"
}

### 9c. Invalid Profile Update: Invalid Photo URL -> Expects 400 Bad Request
# @name testInvalidPhotoUrl
PUT {{baseUrl}}/api/auth/profile
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "photo": "not-a-url"
}

### 9d. Unauthorized Dashboard Access (No Token) -> Expects 401 Unauthorized
# @name testUnauthorizedDashboard
GET {{baseUrl}}/api/users/me
Content-Type: {{contentType}}

###


### ====================================================================
### SCREEN 8: ACTIVITY SEARCH / CITY SEARCH (ALL SCENARIOS)
### ====================================================================

### STEP 1: Get All Activities (Default Listing & Pagination)
# @name getAllActivities
GET {{baseUrl}}/api/activities
Content-Type: {{contentType}}

### STEP 2: Dedicated Activity Search (e.g. Paragliding)
# @name searchActivitiesDedicated
GET {{baseUrl}}/api/activities/search?q=paragliding
Content-Type: {{contentType}}

### STEP 3: Dedicated City Search (e.g. Tokyo)
# @name searchDestinationsDedicated
GET {{baseUrl}}/api/destinations/search?q=tokyo
Content-Type: {{contentType}}

### STEP 4: Case-Insensitive Activity Search on Main Endpoint
# @name searchActivitiesCaseInsensitive
GET {{baseUrl}}/api/activities?q=PARAGLIDING
Content-Type: {{contentType}}

### STEP 5: Filter Activities by Category (e.g. Adventure, Food, Culture)
# @name filterActivitiesCategory
GET {{baseUrl}}/api/activities?category=Adventure
Content-Type: {{contentType}}

### STEP 6: Filter Activities by Destination ID
# @name filterActivitiesDestination
GET {{baseUrl}}/api/activities?destinationId=1
Content-Type: {{contentType}}

### STEP 7a: Sort Activities by Popularity
# @name sortActivitiesPopularity
GET {{baseUrl}}/api/activities?sort=popularity_desc
Content-Type: {{contentType}}

### STEP 7b: Sort Activities by Name Ascending
# @name sortActivitiesName
GET {{baseUrl}}/api/activities?sort=name_asc
Content-Type: {{contentType}}

### STEP 7c: Sort Activities by Price / Cost Ascending
# @name sortActivitiesPrice
GET {{baseUrl}}/api/activities?sort=price_asc
Content-Type: {{contentType}}

### STEP 8: Group Activities by Category
# @name groupActivitiesCategory
GET {{baseUrl}}/api/activities?groupBy=category
Content-Type: {{contentType}}

### STEP 9: Group Activities by Destination / City
# @name groupActivitiesDestination
GET {{baseUrl}}/api/activities?groupBy=destination
Content-Type: {{contentType}}

### STEP 10: Paginate Activities (Page 1, Limit 5)
# @name paginateActivities
GET {{baseUrl}}/api/activities?page=1&limit=5
Content-Type: {{contentType}}

### STEP 11: Combined Query (Search + Category + Rating + Pagination)
# @name combinedActivitiesQuery
GET {{baseUrl}}/api/activities?q=paragliding&category=adventure&sort=rating_desc&page=1&limit=10
Content-Type: {{contentType}}

### STEP 12: Single Activity Details by ID
# @name getSingleActivityDetails
GET {{baseUrl}}/api/activities/28
Content-Type: {{contentType}}

### STEP 13: Single Destination Details by ID (With Top Activities)
# @name getSingleDestinationDetails
GET {{baseUrl}}/api/destinations/1
Content-Type: {{contentType}}

### STEP 14: Search with No Results (Returns 200 with empty array)
# @name searchNoResults
GET {{baseUrl}}/api/activities?q=nonexistent_xyz_query
Content-Type: {{contentType}}

###


### ====================================================================
### SCREEN 8 VALIDATION & ERROR CHECKS
### ====================================================================

### 15a. Invalid Sort -> Expects 400 Bad Request
# @name testInvalidActivitySort
GET {{baseUrl}}/api/activities?sort=invalid_sort
Content-Type: {{contentType}}

### 15b. Invalid GroupBy -> Expects 400 Bad Request
# @name testInvalidActivityGroupBy
GET {{baseUrl}}/api/activities?groupBy=invalid_group
Content-Type: {{contentType}}

### 15c. Invalid Price Range (maxPrice < minPrice) -> Expects 400 Bad Request
# @name testInvalidActivityPrice
GET {{baseUrl}}/api/activities?minPrice=10000&maxPrice=1000
Content-Type: {{contentType}}

### 15d. Invalid Rating (> 5) -> Expects 400 Bad Request
# @name testInvalidActivityRating
GET {{baseUrl}}/api/activities?minRating=10
Content-Type: {{contentType}}

### 15e. Invalid Page (< 1) -> Expects 400 Bad Request
# @name testInvalidActivityPage
GET {{baseUrl}}/api/activities?page=-1
Content-Type: {{contentType}}

### 15f. Invalid Limit (> 50) -> Expects 400 Bad Request
# @name testInvalidActivityLimit
GET {{baseUrl}}/api/activities?limit=99999
Content-Type: {{contentType}}

###


### ====================================================================
### SCREEN 9: ITINERARY VIEW WITH BUDGET (ALL SCENARIOS)
### ====================================================================

### STEP 1: Add First Itinerary Activity to Day 1 (2026-10-10)
# @name addItineraryActivity1
POST {{baseUrl}}/api/trips/{{tripId}}/activities
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "activityId": 1,
  "plannedDate": "2026-10-10",
  "startTime": "10:00",
  "endTime": "12:00",
  "order": 1,
  "expense": 5000,
  "currency": "INR",
  "notes": "Morning sightseeing activity"
}

### STEP 2: Add Second Itinerary Activity to Day 1 (2026-10-10)
# @name addItineraryActivity2
POST {{baseUrl}}/api/trips/{{tripId}}/activities
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "activityId": 2,
  "plannedDate": "2026-10-10",
  "startTime": "14:00",
  "endTime": "16:00",
  "order": 2,
  "expense": 2500,
  "currency": "INR",
  "notes": "Afternoon culture activity"
}

### STEP 3: Add Third Itinerary Activity to Day 2 (2026-10-11)
# @name addItineraryActivity3
POST {{baseUrl}}/api/trips/{{tripId}}/activities
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "activityId": 3,
  "plannedDate": "2026-10-11",
  "startTime": "09:00",
  "endTime": "11:00",
  "order": 1,
  "expense": 3000,
  "currency": "INR",
  "notes": "Day 2 food tour"
}

### STEP 4: Get Complete Day-Wise Itinerary (Shows Day 1, Day 2, Expenses & Budget)
# @name getCompleteItinerary
GET {{baseUrl}}/api/trips/{{tripId}}/itinerary
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 5: Get Day 1 Detail by Date
# @name getDay1Detail
GET {{baseUrl}}/api/trips/{{tripId}}/itinerary/day/2026-10-10
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 6: Get Trip Budget with Daily Breakdown & Over-Budget Flag
# @name getTripBudgetDetails
GET {{baseUrl}}/api/trips/{{tripId}}/budget
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 7: Search Itinerary Items by Query
# @name searchItinerary
GET {{baseUrl}}/api/trips/{{tripId}}/itinerary?search=sightseeing
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 8: Filter Itinerary by Single Date
# @name filterItineraryByDate
GET {{baseUrl}}/api/trips/{{tripId}}/itinerary?date=2026-10-10
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 9a: Sort Itinerary by Expense Descending
# @name sortItineraryExpenseDesc
GET {{baseUrl}}/api/trips/{{tripId}}/itinerary?sort=expense_desc
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 9b: Sort Itinerary by Start Time Ascending
# @name sortItineraryStartTimeAsc
GET {{baseUrl}}/api/trips/{{tripId}}/itinerary?sort=start_time_asc
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 10: Group Itinerary by Category
# @name groupItineraryCategory
GET {{baseUrl}}/api/trips/{{tripId}}/itinerary?groupBy=category
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

### STEP 11: Update Itinerary Activity (Change Date to Day 2 & Expense to 6000)
# @name updateItineraryActivity
PUT {{baseUrl}}/api/trips/{{tripId}}/activities/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "plannedDate": "2026-10-11",
  "startTime": "11:00",
  "endTime": "13:00",
  "order": 2,
  "expense": 6000,
  "currency": "INR",
  "notes": "Updated plan moved to Day 2"
}

### STEP 12: Reorder Itinerary Items within Day 2
# @name reorderItineraryDay
PUT {{baseUrl}}/api/trips/{{tripId}}/itinerary/reorder
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "date": "2026-10-11",
  "itemIds": [2, 1]
}

### STEP 13: Delete Activity from Itinerary
# @name deleteItineraryActivity
DELETE {{baseUrl}}/api/trips/{{tripId}}/activities/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

